{
  "name": "@samad001z/norn-server",
  "version": "1.3.0",
  "mcpName": "io.github.samad001z/norn",
  "description": "Norn MCP server with remember, recall, forget, and list tools over stdio.",
  "license": "MIT",
  "author": "samad001z",
  "homepage": "https://github.com/samad001z/Norn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samad001z/Norn.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/samad001z/Norn/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "memory",
    "ai-memory",
    "claude",
