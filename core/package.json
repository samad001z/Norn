{
  "name": "@samad001z/norn-core",
  "version": "1.2.0",
  "description": "Norn memory store: local SQLite + sqlite-vec, with a swappable embedding interface.",
  "license": "MIT",
  "author": "samad001z",
  "homepage": "https://github.com/samad001z/Norn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samad001z/Norn.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/samad001z/Norn/issues"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai-memory",
    "embeddings",
    "sqlite",
    "sqlite-vec",
    "local-first",
    "claude",
    "cursor",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "norn": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "cli": "tsx src/cli.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
